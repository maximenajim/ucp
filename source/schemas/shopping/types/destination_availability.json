{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ucp.dev/schemas/shopping/types/destination_availability.json",
  "title": "Destination Availability",
  "description": "Availability for a buyer-visible fulfillment destination under a specific catalog fulfillment method.",
  "oneOf": [
    {
      "allOf": [
        { "$ref": "shipping_destination.json" },
        {
          "type": "object",
          "required": ["destination_type"],
          "additionalProperties": true,
          "properties": {
            "destination_type": {
              "const": "shipping_destination",
              "description": "Discriminator for a shipping destination."
            },
            "availability": {
              "$ref": "availability_summary.json",
              "description": "Availability at this destination."
            },
            "description": {
              "type": "string",
              "description": "Buyer-facing destination-specific availability detail."
            }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "retail_location.json" },
        {
          "type": "object",
          "required": ["destination_type"],
          "additionalProperties": true,
          "properties": {
            "destination_type": {
              "const": "retail_location",
              "description": "Discriminator for a retail location."
            },
            "availability": {
              "$ref": "availability_summary.json",
              "description": "Availability at this destination."
            },
            "description": {
              "type": "string",
              "description": "Buyer-facing destination-specific availability detail."
            }
          }
        }
      ]
    }
  ]
}
